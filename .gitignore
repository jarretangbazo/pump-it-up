# =============================================================================
# Flu Shot Learning — .gitignore
# =============================================================================

# -----------------------------------------------------------------------------
# Data — never commit raw or processed data files
# -----------------------------------------------------------------------------
data/raw/
data/processed/
*.csv
*.parquet
*.feather
*.json
*.xlsx

# Keep the folder structure but not the files
!data/.gitkeep
!data/raw/.gitkeep
!data/processed/.gitkeep

# -----------------------------------------------------------------------------
# Models — .pkl files can be large and are reproducible from training scripts
# -----------------------------------------------------------------------------
models/
*.pkl
*.pickle
*.joblib
*.pt
*.pth
!models/.gitkeep

# -----------------------------------------------------------------------------
# Submissions
# -----------------------------------------------------------------------------
submissions/
!submissions/.gitkeep

# -----------------------------------------------------------------------------
# MLflow — experiment tracking data grows large quickly
# -----------------------------------------------------------------------------
mlruns/
mlartifacts/
.mlflow/

# -----------------------------------------------------------------------------
# Logs
# -----------------------------------------------------------------------------
logs/
*.log
!logs/.gitkeep

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# Virtual environments
flu_env/
venv/
env/
.env/
.venv/
ENV/

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
.eggs/
wheels/

# -----------------------------------------------------------------------------
# Jupyter Notebooks
# -----------------------------------------------------------------------------
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# Notebook outputs (optional — remove these lines if you want outputs committed)
# *.ipynb

# old script versions
notebooks/archive/

# -----------------------------------------------------------------------------
# R
# -----------------------------------------------------------------------------

# renv — library folder is reproducible from renv.lock; lock file is committed
renv/library/
renv/staging/
renv/sandbox/

# Commit renv.lock and renv/activate.R — these are needed for reproducibility
!renv/activate.R
!renv.lock

# RStudio project artifacts — .Rproj is committed; user-specific state is not
.Rproj.user/
.Rhistory
.RData
.Ruserdata

# R temporary and output files
*.Rout
*.rdb
*.rdx

# Compiled R packages and shared objects
*.so
*.dll

# -----------------------------------------------------------------------------
# Word documents — committed .docx files and ghost temp files
# -----------------------------------------------------------------------------

# Ghost files created by Word/Office when a document is open (never meaningful)
~$*.docx
~$*.doc
~$*.xlsx
~$*.xls
~$*.pptx
~$*.ppt

# All .docx files — resume and report outputs are reproducible from source
*.docx
*.doc

# -----------------------------------------------------------------------------
# Environment variables — may contain API keys or credentials
# -----------------------------------------------------------------------------
.env
.env.local
.env.production
*.env

# -----------------------------------------------------------------------------
# OS generated files
# -----------------------------------------------------------------------------

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~

# -----------------------------------------------------------------------------
# IDEs and editors
# -----------------------------------------------------------------------------

# VS Code — settings.json is committed for shared interpreter config; 
# extensions and workspace state are local
.vscode/*
!.vscode/settings.json
*.code-workspace

# RStudio (covered above under R section)

# PyCharm / JetBrains
.idea/
*.iml

# Jupyter
.jupyter/

# Spyder
.spyderproject.cfg
.spyproject/

# -----------------------------------------------------------------------------
# Docker
# -----------------------------------------------------------------------------
.docker/

# -----------------------------------------------------------------------------
# Testing and coverage
# -----------------------------------------------------------------------------
.pytest_cache/
.coverage
htmlcov/
.tox/
nosetests.xml
coverage.xml

# -----------------------------------------------------------------------------
# Streamlit
# -----------------------------------------------------------------------------
.streamlit/secrets.toml